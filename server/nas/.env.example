# Gitea 管理员 token（部署步骤第 3 步生成）
GITEA_ADMIN_TOKEN=
# Gitea 对外地址（clone URL 前缀；NAS 实际地址）
GITEA_ROOT_URL=http://nas:3000/
# 端口映射（默认 3000/2222/3100）
# GITEA_HTTP_PORT=3000
# GITEA_SSH_PORT=2222
# OKSERVER_PORT=3100
# okserver 镜像（默认 z7dream/openknowledge-okserver:latest）
# OKSERVER_IMAGE=ghcr.io/<owner>/okserver:latest
